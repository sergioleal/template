# Configuração do seu nó. Copie para deploy/config.env (fora do git) e preencha.
# Nenhum segredo aqui: senhas e chaves são geradas em deploy/segredos/ pelo "npm run implantar".

# --- A VM (qualquer provedor: Ubuntu 22.04+ com acesso SSH) ---
VM_IP=
# root, ou um usuário com sudo sem senha (ex.: ubuntu na AWS)
VM_USUARIO=root
# Chave SSH que entra na VM (a pública precisa estar no ~/.ssh/authorized_keys dela)
SSH_CHAVE=~/.ssh/id_ed25519

# --- Identidade ---
# Nome exibido no site do nó e no hub (ex.: "Minha Empresa")
NOME=
# Cor principal do site, #RRGGBB (opcional)
COR=
# Identificador curto, minúsculo, sem espaços (realm do Keycloak, nome do túnel e do Worker)
SLUG=

# --- Endereços (um domínio seu no Cloudflare) ---
# Site do nó (Worker do Cloudflare)
SITE=agentes.suaempresa.com.br
# API do nó (túnel; o Worker repassa para cá)
API=api-agentes.suaempresa.com.br
# Login (Keycloak, pelo túnel)
AUTH=auth-agentes.suaempresa.com.br
# Servidor MCP dos agentes (pelo túnel). Cada agente fica em https://<MCP>/<pasta>/mcp
MCP=mcp-agentes.suaempresa.com.br

# --- Hub ---
HUB_URL=https://registry.agentik.al
# Dados que o administrador do hub devolve ao aprovar o nó (npm run implantar -- chave)
NODE_CODE=
ID_PREFIX=
